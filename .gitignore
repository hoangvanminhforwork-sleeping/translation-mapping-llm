# --- personal / machine-specific (git-62: contains device + personal information)
ClineClean/
Local_LLM_runable/

# --- internal-only documents (not for reviewers)
previous-proposal/

# --- scratch + environment (re-derivable, large)
agent-work/
.venv/
__pycache__/
*.pyc

# --- coincidence-solution: 4.1 GB of cached encoder states are re-derivable in 150 s, but the
# fitted maps and the generated hypotheses ARE results and must stay traceable (git-62:
# hide inputs, publish results). Re-include the directory, then re-ignore the bulk.
!coincidence-solution/agent-work/
coincidence-solution/agent-work/cache/
coincidence-solution/agent-work/logs/
coincidence-solution/agent-work/*.py
coincidence-solution/agent-work/*.txt
coincidence-solution/.env

# --- large input corpus. ANCHORED on purpose: `data/` would also hide
# research-prototype/data/culinary_100_pairs.jsonl, which is authored source data.
/data/

# --- model weights (re-downloadable, GB-sized)
research-prototype/models/

# --- autonomous-research-experiment: inputs and weights are re-derivable, results are not.
# `results/` (pools, features, COMET labels, selections, metrics) is TRACKED on purpose:
# every table in REPORT.md must stay recomputable from committed files.
autonomous-research-experiment/models/
autonomous-research-experiment/data/
autonomous-research-experiment/logs/
autonomous-research-experiment/*.tmp
autonomous-research-experiment/.env
# back-translations are deterministic given the pool + frozen model (regenerable, 33 MB)
autonomous-research-experiment/results/bt_*.json

# --- downloaded reference PDFs: inputs, not results. The PRISMA workbooks and
# the .md/.csv results living next to them stay tracked.
draft/**/*.pdf
References/*.pdf

# --- secrets. Local is the source of truth, but keys must not leave the machine.
# research-phase01/.env and research-prototype/.env were committed in early history
# and untracked on 2026-11-26; the old keys remain in history, so rotate if the repo
# ever needs to be private again.
.env
*.env

# --- research-phase01-1.2: 526 MB of encoder states are re-derivable in minutes,
# mission notes are internal working material (agents.md 5/6).
research-phase01-1.2/data/
research-phase01-1.2/missions.md
research-phase01-1.2/model.txt
research-phase01-1.2/communnication.txt

# --- raw agent conversation transcripts: internal working material, not evidence.
conversation/

# --- personal photos and seminar material: not paper evidence.
present-Saturday-24th Oct/

# --- scratch
coincidence-solution/scientific-communication/temp.docx
